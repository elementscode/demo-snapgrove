import { Avatar as PhotoAvatar } from "@elements/ui/avatar";
import { avatarUrl, AvatarRef } from "#app/shared/services/photos";

export interface AvatarUser extends AvatarRef {
  handle: string;
  name?: string;
  avatarUrl?: string;
}

function initial(u: AvatarUser): string {
  return (u.name || u.handle || "?").charAt(0).toUpperCase();
}

// A user's photo at any pixel size, with their initial while it loads or
// when they have none. `src` shows a photo in place of theirs (a preview).
<Avatar (user: AvatarUser, size: number = 32, src: string = "")>
  <PhotoAvatar src={src || user.avatarUrl || avatarUrl(user)}
               fallback={initial(user)}
               lazy={true}
               attrs={{ style: `--avatar-size:${size}px` }}>
    <slot/>
  </PhotoAvatar>
</Avatar>
