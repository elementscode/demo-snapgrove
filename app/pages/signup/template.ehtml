import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { signup, MIN_PASSWORD, SignupForm } from "#app/shared/services/auth";
import { SEED, MOSAIC } from "#app/shared/services/photos";
import { Logo } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SignupState {
  form: SignupForm;
  errors: Record<string, string[]>;
  error: string;
  busy: boolean;
}

function onSubmit(state: SignupState) {
  state.busy = true;

  try {
    signup(state.form);
    state.errors = {};
    state.error = "";
    redirect("/settings");
  } catch (err: any) {
    state.busy = false;

    if (err instanceof ValidationError && typeof err.errors === "object") {
      state.errors = err.errors as Record<string, string[]>;
      state.error = "";
    } else {
      state.error = err.message;
    }
  }
}

<html lang="en" class="page-signup" (
  private state: SignupState = {
    form: { handle: "", name: "", email: "", password: "" },
    errors: {},
    error: "",
    busy: false,
  },
)>
  <head>
    <title>Create an account · snapgrove</title>
    <meta name="description" content="Create a snapgrove account.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="auth">
      <div class="auth-mosaic" aria-hidden="true">
        <img e:for={key of MOSAIC.slice().reverse()} src={SEED[key]} alt="" width="300" height="300">
        <div class="auth-tagline">
          <h2>Start your grove.</h2>
          <p>Post a photo, follow a few people, and your feed fills itself.</p>
        </div>
      </div>

      <main class="auth-panel">
        <div class="auth-card stack is-lg">
          <div class="auth-brand"><Logo size={32}/> snapgrove</div>

          <form class="stack" onsubmit={() => onSubmit(state)}>
            <h1 class="text-2xl">Create your account</h1>

            <Alert e:if={state.error} variant="danger" description={state.error}/>

            <Field label="Handle" error={state.errors.handle?.[0] || ""}>
              <Input name="handle"
                     value={state.form.handle}
                     placeholder="yourname"
                     required={true}
                     attrs={{ autocomplete: "username", autocapitalize: "none", spellcheck: "false" }}/>
            </Field>

            <Field label="Name" reserveError={false}>
              <Input name="name" value={state.form.name} placeholder="Your Name" attrs={{ autocomplete: "name" }}/>
            </Field>

            <Field label="Email" error={state.errors.email?.[0] || ""}>
              <Input name="email"
                     type="email"
                     value={state.form.email}
                     placeholder="you@example.com"
                     required={true}
                     attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }}/>
            </Field>

            <Field label="Password"
                   description={`at least ${MIN_PASSWORD} characters`}
                   error={state.errors.password?.[0] || ""}>
              <Input name="password"
                     type="password"
                     value={state.form.password}
                     required={true}
                     attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }}/>
            </Field>

            <Button type="submit" variant="primary" block={true} loading={state.busy}>Create account</Button>
          </form>

          <p class="auth-alt">Have an account? <a href="/signin">Sign in</a></p>
        </div>
      </main>
    </div>
  </body>
</html>
