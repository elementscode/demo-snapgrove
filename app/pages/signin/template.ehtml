import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { signin, DEMO_PASSWORD } from "#app/shared/services/auth";
import { SEED, MOSAIC } from "#app/shared/services/photos";
import { Logo } from "#app/shared/templates/layout";
import { Avatar } from "#app/shared/templates/avatar";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

export interface DemoAccount {
  id: string;
  handle: string;
  name: string;
  email: string;
  avatarSeed: string | null;
}

interface SigninForm {
  login: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.login, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onDemoClick(form: SigninForm, account: DemoAccount) {
  form.login = account.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  demo: DemoAccount[],
  private form: SigninForm = { login: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · snapgrove</title>
    <meta name="description" content="Sign in to snapgrove, a place to share photos with people you follow.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="auth">
      <div class="auth-mosaic" aria-hidden="true">
        <img e:for={key of MOSAIC} src={SEED[key]} alt="" width="300" height="300">
        <div class="auth-tagline">
          <h2>Share the view.</h2>
          <p>Photos from the people you follow, the moment they post them.</p>
        </div>
      </div>

      <main class="auth-panel">
        <div class="auth-card stack is-lg">
          <div class="auth-brand"><Logo size={32}/> snapgrove</div>

          <form class="stack" onsubmit={() => onSubmit(form)}>
            <h1 class="text-2xl">Welcome back</h1>

            <Alert e:if={form.error} variant="danger" description={form.error}/>

            <Field label="Email or handle" reserveError={false}>
              <Input name="login"
                     value={form.login}
                     placeholder="maya@snapgrove.dev"
                     required={true}
                     attrs={{ autocomplete: "username", autocapitalize: "none", spellcheck: "false" }}/>
            </Field>

            <Field label="Password" reserveError={false}>
              <Input name="password"
                     type="password"
                     value={form.password}
                     required={true}
                     attrs={{ autocomplete: "current-password" }}/>
            </Field>

            <Button type="submit" variant="primary" block={true} loading={form.busy}>Sign in</Button>
          </form>

          <section e:if={demo.length > 0} class="auth-demo stack is-sm">
            <div class="auth-demo-head">
              <h2>Demo accounts</h2>
              <p>password <code>{DEMO_PASSWORD}</code></p>
            </div>

            <ul class="auth-demo-list">
              <li e:for={a of demo}>
                <Button block={true} attrs={{ title: `Sign in as ${a.email}` }} onclick={() => onDemoClick(form, a)}>
                  <Avatar user={a} size={30}/>
                  <span class="auth-demo-who">
                    <strong>{a.name}</strong>
                    <small>{a.email}</small>
                  </span>
                </Button>
              </li>
            </ul>
          </section>

          <p class="auth-alt">New here? <a href="/signup">Create an account</a></p>
        </div>
      </main>
    </div>
  </body>
</html>
