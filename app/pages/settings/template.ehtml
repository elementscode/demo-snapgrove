import "./style.css";
import { LiveView, redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Me } from "#app/shared/services/auth";
import { Note } from "#app/shared/services/notifications";
import { updateProfile, ProfileForm, MAX_BIO } from "#app/shared/services/uploads";
import { previewUrl } from "#app/shared/services/preview";
import { Layout } from "#app/shared/templates/layout";
import { Avatar } from "#app/shared/templates/avatar";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";

interface Settings {
  form: ProfileForm;
  error: string;
  busy: boolean;
}

function onSubmit(me: Me, state: Settings) {
  state.busy = true;
  state.error = "";

  try {
    updateProfile(state.form);
    redirect(`/u/${me.handle}`);
  } catch (err: any) {
    state.error = err.message;
    state.busy = false;
  }
}

<html lang="en" class="page-settings" (
  me: Me,
  notes: LiveView<Note>,
  bio: string,
  private state: Settings = { form: { name: me.name, bio }, error: "", busy: false },
)>
  <head>
    <title>Edit profile · snapgrove</title>
    <meta name="description" content="Edit your snapgrove profile.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {me} {notes} active="profile">
      <form class="settings stack is-lg" onsubmit={() => onSubmit(me, state)}>
        <h1 class="text-2xl">Edit profile</h1>

        <Alert e:if={state.error} variant="danger" description={state.error}/>

        <div class="settings-avatar">
          <Avatar user={me} size={88} src={previewUrl(state.form.avatar)}/>

          <div class="stack is-xs">
            <strong>@{me.handle}</strong>
            <span class="button is-sm settings-pick">
              Change photo
              <input type="file" name="avatar" accept="image/png,image/jpeg,image/gif,image/webp" value={state.form.avatar} aria-label="profile photo">
            </span>
          </div>
        </div>

        <Field label="Name" reserveError={false}>
          <Input name="name" value={state.form.name} attrs={{ maxlength: 60, autocomplete: "name" }}/>
        </Field>

        <Field label="Bio" description={`${state.form.bio.length} / ${MAX_BIO}`}>
          <Textarea name="bio" rows={3} maxlength={MAX_BIO} value={state.form.bio} placeholder="A line or two about you and what you shoot"/>
        </Field>

        <div class="settings-actions">
          <Button variant="ghost" href={`/u/${me.handle}`}>Cancel</Button>
          <Button type="submit" variant="primary" loading={state.busy}>Save</Button>
        </div>
      </form>
    </Layout>
  </body>
</html>
